# Version control and CI metadata
.git
.gitignore
.github

# Secrets and local environment — never bake these into an image.
# Config is supplied at runtime via environment variables instead.
.env*

# Virtual environments
venv
.venv
env

# Python caches and build artifacts
__pycache__
*.py[cod]
*$py.class
*.egg-info
.eggs
build
dist
.pytest_cache
.mypy_cache
.ruff_cache

# Not needed at runtime: tests run in CI, the API serves no static files
tests
frontend
docs
README.md
CLAUDE.md

# Node — unused today, listed so a future frontend build cannot leak in
node_modules

# OS / editor cruft
.DS_Store
.idea
.vscode
.claude
