# Version control and CI metadata
.git
.gitignore
.github

# Secrets and local environment — never bake these into an image.
# Config is supplied at runtime via environment variables instead.
.env*

# Virtual environments
venv
.venv
env

# Python caches and build artifacts.
# The `**/` prefix is load-bearing: Docker matches ignore patterns against the
# path relative to the build-context root, so a bare `__pycache__` matches only a
# top-level entry. This repo has none — every cache sits under app/ — so the bare
# patterns matched nothing and `COPY app ./app` shipped ten of them into the
# image. Verified by building; CI could not catch it because a fresh checkout has
# no bytecode to exclude in the first place.
**/__pycache__
**/*.py[cod]
*$py.class
*.egg-info
.eggs
build
dist
.pytest_cache
.mypy_cache
.ruff_cache

# Not needed at runtime: tests run in CI, the API serves no static files
tests
frontend
docs
README.md
CLAUDE.md

# Node — unused today, listed so a future frontend build cannot leak in
node_modules

# OS / editor cruft
.DS_Store
.idea
.vscode
.claude
